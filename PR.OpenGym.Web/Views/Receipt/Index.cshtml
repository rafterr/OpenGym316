@model ReceiptListViewModel
@{
    var culture = ReceiptDisplayExtensions.MexicoCulture;
    var active = Model.Receipts.Where(r => r.Status == ReceiptStatus.Active).ToList();
}

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-6 col-md-3">
        <label for="from" class="form-label">Desde</label>
        <input type="date" id="from" name="from" class="form-control" value="@Model.From.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-6 col-md-3">
        <label for="to" class="form-label">Hasta</label>
        <input type="date" id="to" name="to" class="form-control" value="@Model.To.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-12 col-md-2">
        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> Buscar</button>
    </div>
</form>

<div class="row g-2 mb-3">
    <div class="col-12 col-md-4">
        <div class="card"><div class="card-body">
            <div class="text-muted">Total cobrado (vigentes)</div>
            <div class="fs-4 fw-bold">@active.Sum(r => r.Amount).ToMoney()</div>
        </div></div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card"><div class="card-body">
            <div class="text-muted">Efectivo</div>
            <div class="fs-4">@active.Where(r => r.PaymentMethod == PaymentMethod.Cash).Sum(r => r.Amount).ToMoney()</div>
        </div></div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card"><div class="card-body">
            <div class="text-muted">Transferencia</div>
            <div class="fs-4">@active.Where(r => r.PaymentMethod == PaymentMethod.Transfer).Sum(r => r.Amount).ToMoney()</div>
        </div></div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>Folio</th>
                <th>Fecha</th>
                <th>Socio</th>
                <th>Membresia</th>
                <th>Metodo</th>
                <th class="text-end">Monto</th>
                <th>Estatus</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Receipts.Any())
            {
                <tr><td colspan="8" class="text-center text-muted">No hay recibos en el periodo</td></tr>
            }
            @foreach (var receipt in Model.Receipts)
            {
                <tr class="@(receipt.Status == ReceiptStatus.Cancelled ? "text-decoration-line-through text-muted" : "")">
                    <td>@receipt.Folio</td>
                    <td>@receipt.CreatedOn.ToString("dd/MM/yyyy hh:mm tt", culture)</td>
                    <td>@receipt.AssociateName</td>
                    <td>@receipt.MembershipName</td>
                    <td>@receipt.PaymentMethod.ToDisplay()</td>
                    <td class="text-end">@receipt.Amount.ToMoney()</td>
                    <td>@receipt.Status.ToDisplay()</td>
                    <td>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Print" asp-route-id="@receipt.Id" target="_blank">
                            <i class="bi bi-printer"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
