@model AssociateAndDetailsViewModel

@section Styles
    {
    <link rel="stylesheet" type="text/css" href="~/css/customStyles.css" />
}

@if (!Model.IsFaceTerminalConnected)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill text-warning"></i>
        No se pudo conectar con la terminal de reconocimiento facial, las altas de usuarios no estan disponibles
        <a href="/Associate/Create">
            <i class="bi bi-arrow-clockwise"></i>
        </a>
    </div>    

}

<div class="d-flex justify-content-center mt-3">
    <div class="card" style="width:300px">
        <img src="" class="card-img-top d-none" alt="persona" id="imgPersona" height="250">
        <img src="~/img/face_scann.gif" class="card-img-top d-none" alt="scann" id="imgFaceScann">
        <div class="card-body">
            <p class="card-text">Hola! Bienvenido</p>
            <p id="displayName" class="h5"></p>
        </div>
        <div class="card-footer text-center">
            @*    <input id="inputImgPersona" type="file" class="form-control form-control-sm  d-block d-sm-none" capture="camera" />
            <button id="btnOpenCamera" class="btn btn-info d-none d-sm-block"> <i class="fa fa-camera"></i> Abrir Camara</button>*@
            <button id="btnCapturaImage" class="btn btn-secondary text-white"> <i class="bi bi-camera"></i> Capturar</button>
        </div>
    </div>
</div>




<form asp-action="Create" class="mt-4 mb-4" enctype="multipart/form-data">
    <partial name="_FormAssociate" model="Model" />
</form>


<div class="modal fade text-center" id="photoModal" tabindex="-1" aria-labelledby="associateModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="associateModalLabel"></h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <video id="webcam" autoplay playsinline width="640" height="480"></video>
                <canvas id="canvas" class="d-none"></canvas>
            </div>
            <div class="modal-footer">
                <button id="takePhoto"> <i class="fa fa-camera"></i> Tomar Foto</button>
            </div>
        </div>
    </div>
</div>


