@page
@model LoginModel

@{
    Layout = "";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <meta name="author" content="Mark Otto, Jacob Thornton, and Bootstrap contributors">
    <meta name="generator" content="Hugo 0.84.0">
    <title>Iniciar sesion</title>

    @*<link rel="canonical" href="https://getbootstrap.com/docs/5.0/examples/sign-in/">*@



    <!-- Bootstrap core CSS -->
    <link href="~/lib//bootstrap//dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        .bd-placeholder-img {
            font-size: 1.125rem;
            text-anchor: middle;
            -webkit-user-select: none;
            -moz-user-select: none;
            user-select: none;
        }

        @@media (min-width: 768px) {
            .bd-placeholder-img-lg {
                font-size: 3.5rem;
            }
        }
    </style>


    <!-- Custom styles for this template -->
    <link href="~/css/signin.css" rel="stylesheet">
</head>
<body class="text-center">

    <main class="form-signin">
        <form id="account" method="post">
            <img class="mb-4" src="~/img/bodybuilder.svg" alt="" width="72" height="57">
            <h1 class="h3 mb-3 fw-normal">Bienvenido</h1>
            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-floating">
                <input asp-for="Input.Email" type="email" class="form-control" placeholder="name@example.com">
                <label asp-for="Input.Email">Email</label>
            </div>
            <div class="form-floating">
                <input asp-for="Input.Password" type="password" class="form-control" placeholder="Password">
                <label asp-for="Input.Password" >Contraseña</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="checkbox mb-3">
                <label asp-for="Input.RememberMe">
                    <input class="form-check-input" asp-for="Input.RememberMe" type="checkbox"> Recuérdame
                </label>
            </div>
            <button class="w-100 btn btn-lg btn-primary" type="submit">Iniciar sesion</button>
            <p class="mt-5 mb-3 text-muted">3:16 Fitness - &copy; 2023</p>
        </form>
    </main>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }


</body>
</html>

